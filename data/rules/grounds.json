{
  // The closed ground library (spec §6.1, §16; FD-05). One named row per ground id a park's zone
  // may name, and the only copy of these numbers (F3-c): the batted ball's roll, bounce and skid,
  // the overthrow's roll and the local bobble each read the row of the zone the ball is in. Every
  // row is today's number - what flight.json's roll / bounce / skid and fielding.json's
  // overthrow.decelFtPerSec2 and handling.bobble* carried - so the ground under the ball changes no
  // play. A value that is not today's arrives with Crystal (F9-a), as a trial Jack has accepted.
  //
  // `body` is what the ground does to a body standing on it (spec §8, §9; FD-04 B, F3-d). Each
  // multiplier scales a TIME or a LENGTH, never a speed, so above 1 always reads "more slippery":
  // startMul x fielding.chase.accelSec (rest to speed, and the planner's half-ramp), brakeMul x
  // fielding.chase.brakeSec (speed to rest), cutMul x the time the across-heading correction takes
  // (the ramp time: the cut-back), slideMul x running.bags.slideFt and overrunMul x
  // running.bags.overrunFt (read at the bag's zone). The stick, the heading and the top speed are
  // never scaled: the body always goes where it is pointed. Start, brake and cut-back act only
  // where the response law is on (accelSec / brakeSec above 0, as shipped). Every row is 1.0.
  "grass": {
    "roll": {
      "friction": 22,
      "restSpeed": 1.4
    },
    "bounce": {
      "restitution": 0.48,
      "horizontal": 0.82,
      "minVy": 3.6
    },
    "skid": {
      "launchMinDeg": 14,
      "launchMaxDeg": 22,
      "minVy": 2.2,
      "restitution": 0.28,
      "horizontal": 0.93
    },
    "overthrow": {
      "decelFtPerSec2": 18
    },
    "bobble": {
      "restitution": 0.35,
      "groundRetain": 0.90,
      "decelFtPerSec2": 6
    },
    "body": {
      "startMul": 1.0,
      "brakeMul": 1.0,
      "cutMul": 1.0,
      "slideMul": 1.0,
      "overrunMul": 1.0
    }
  },

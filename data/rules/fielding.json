{
  "chase": {
    // #718 (F693-02-pursuit-*): the whole speed curve x 18 / 30.5, so a Run-5 body runs 18.0 ft/s where it ran 30.5 and the
    // spread between characters is kept (1.12 / 12.4 against the full-size 1.9 / 21). The floor scales with it.
    "baseFtPerSec": 12.4,
    "ftPerSecPerRun": 1.12,
    "frozenMul": 0.45,
    "minFtPerSec": 4.72,
    "stepStopFt": 0.35,
    "reachSlackFt": 0.35,
    "swapLockSec": 0.7,
    // F4-g (FD-14): a route that goes around a status volume keeps this far off its disc. Not tuned.
    "volumeClearFt": 2,
    // #633 (S-97): after a hand-off the body the ring left keeps its velocity for this long, then stops (the FIFA
    // "move assistance" idea, spec §8.9). The thrower at a release does not coast (§8.5).
    "handoffCoastSec": 0.2,
    "looseScoopFt": 2.5,
    "wallClearanceFt": 2,
    // #609: the S-29 lever since the outfield read went back to the reference. An outfielder on a ball hit in
    // the air runs at the one glove speed x this. S-29 seeds 1-5: 1.18 / 1.48 runs a side at 1.0 with the 0.83 s
    // read, 2.20 / 2.62 at 0.6 (P7's 2.4 s read at 1.0: 2.52 / 2.72). The fly stretch (flight.timeScale 1.1-1.65)
    // and the launch mix moved it under 0.2: the 2.4 s read had been giving away liners, not flies.
    // #719 (Jack, 2026-09-17): one pursuit profile per body, in the air as on the dirt — the hit-class multipliers retire
    // with the reach. 0.6 (#609) and 0.45 (#636) were the S-29 levers of the full-size field and 30.5 ft/s legs.
    // 3d (#715, PR #757, 2026-09-18) measured what that direction costs: at 1.0 the game ran under the S-29 floor in every
    // cohort (1.28 / 1.04 mixed parks, 1.22 / 1.38 and 0.92 / 1.20 on Harbor) — 18 ft/s legs cover 72 ft under a four-second
    // fly — and this key alone brought every cohort into the 1.8–5 band at 0.6 (2.46 / 2.36, 2.10 / 2.16, 2.02 / 2.42); 0.7
    // landed the away side only, 0.8 neither; the read, the fly stretch and the outfield depth did not get there. Jack set
    // the outfield's multiplier back to 0.6 on 2026-09-18. The infield's stays 1.0.
    "outfieldAirMul": 0.6,
    // #636: the other half of the lever. Once the infield -> outfield hand-off honours the infielder's route in the air
    // (D17, S-97), an infielder under a ball on the stretched clock (a fly or a pop, flight.timeScale 1.65) runs at the
    // one glove speed x this; on a liner (its own clock, 1.0) an infielder runs the one speed, so the rope SS reaches
    // past the lip is SS's. S-29 seeds 1-5 (main at #642: 2.62 / 2.58): D17 in the air at 1.0 reads 1.92 / 1.76, the
    // infield running back under every short fly past the lip; 0.6 (the real clock) 2.18 / 1.94; 0.5 2.38 / 2.18;
    // 0.45 2.64 / 2.32 and 2.16-2.72 a side over four seed sets with infield pops still caught (0.02-0.04 pop hits a
    // game); 0.4 2.72 / 2.12 and pops start to drop. A flat multiplier on every air ball drops liners in front of the
    // infield instead (hits inside the lip 0.04 -> 0.20 a game at 0.6).
    "infieldAirMul": 1.0,
    // #718 (F693-02-carry-movement-response): rest to the rated speed in 0.20 s, the rated speed to rest in 0.10 s; a reversal
    // is the brake and then the ramp. The pursuit planner charges half the ramp to every route. These are the unclassed body's
    // (a character built by hand); every data character plays its body class's ramp (data/rules/body-classes.json, §8.1).
    "accelSec": 0.20,
    "brakeSec": 0.10
  },
  // #718: the calibrated radial pursuit stick. Manual pursuit from 0.20, back to assistance at 0.15, the owner kept between;
  // the asked speed is (magnitude - 0.15) / 0.85 of the glove speed, capped at 1; a seat arms with a valid profile and one
  // neutral observation on defensive-role entry, device recovery or recalibration. The 0.50 s window, 0.10 centre and 0.02
  // spread are the accepted calibration criteria.
  "stick": {
    "enterMag": 0.20,
    "leaveMag": 0.15,
    "calibrationSec": 0.50,
    "centerOffsetMax": 0.10,
    "sampleSpreadMax": 0.02
  },
  "reaction": {
    // #718 (the four read clocks): pitcher 0.35, catcher 0.45, one number for the infield four, outfield 0.40 — the
    // largest single change in the profile, and the one most likely to show in 3d.
    "pitcherSec": 0.35,
    // Full-swing contact leaves the delivery body recovering; bunts retain the quick read.
    "pitcherRecoverySec": 0.65,
    "catcherSec": 0.45,
    "firstSec": 0.25,
    "secondSec": 0.25,
    "thirdSec": 0.25,
    "shortSec": 0.25,
    // 0.40 s (#718; #609 had the reference's 50 frames, 0.83, and P7 2.4 to hold S-29). The human glove waits it at every rung; CPU
    // bodies wait it x cpu.reactionMul; a ball in the air caps every lockout at its hang.
    "outfieldSec": 0.40,
    "throwBaseSec": 0.35,
    "throwPerFieldSec": 0.02,
    "throwMinSec": 0.08
  },
  "cover": {
    // #718 (F693-02-coverage-budget): cover, cutoff and backup walk at the body's own pursuit speed (chaseSpeedWeight 1;
    // ftPerSec is inert here) from contact with no read (startSec 0, lockoutMul 0). Retained in feet: stopFt, radiusFt, backupFt.
    "ftPerSec": 28,
    "startSec": 0,
    "stopFt": 1.2,
    "radiusFt": 6,
    "backupFt": 60,
    "chaseSpeedWeight": 1
  },
  "dash": {
    // #718 (F693-02-ball-dash-carrier): the universal East-held sprint is retired; the only faster carry is Ball Dash's.
    "chaseMul": 1.0,
    "buddyTossFt": 28,
    "kickFt": 22,
    "diveLungeFt": 8,
    "itemSmashFt": 24
  },
  "catch": {
    // The unclassed body's stand-up reach (a character built by hand): every data character reaches its body class's
    // groundReachFt / flyReachFt (data/rules/body-classes.json, §8.1). The dirt pad and the dive add to it. Ability bonuses remain explicit.
    "standUpReachFt": 4.0,
    "clamberRadiusFt": 6,
    // Dirt scoop slack (the §10.4 double-play rows). Not the fly ring: a fly stand-up is
    // the catch radius, and the rim is diveReachFt (#669).
    "windowPadFt": 1,
    "diveReachFt": 2,
    // #719: the jump is the arc below, not eight feet of horizontal reach.
    "jumpReachFt": 0,
    "diveMaxBallY": 7.5,
    "needsJumpReachFt": 22,
    "jumpRobFt": 4,
    "superJumpRobFt": 18,
    "clamberRobFt": 28,
    "buddyJumpRobFt": 18,
    "touchScoopY": 3.2,
    "standingHeightFt": 6.0,
    // §7.11 off the bat: no glove takes the batted ball until it is this far from the contact point (or on the
    // ground). Straight from the bat into the mitt is a foul tip, not a catch.
    "offTheBatFt": 10,
    // §7.6: a liner (or fly) held above this before the first bounce is a catch; at or below it the hop is a scoop.
    "inAirMinY": 0.75,
    "jumpBallY": 2.2,
    "wallBallY": 4.5,
    "windowBeforeSec": 0.48,
    "windowAfterSec": 0.14,
    "wallSitSec": 1.15,
    "superJumpWindowSec": 0.16,
    "growWindowSec": 0.08,
    "clamberWindowSec": 0.12,
    "buddyPlantFt": 4,
    "buddyJumpHoldSec": 0.18,
    "heldBallY": 2.2,
    "buddyHeldBallY": 6.4,
    "buddyLeapBallY": 2.2,
    "hoverLeadSec": 0.4,
    "hoverMinSec": 0.25,
    "diveArmSec": 0.5,
    "diveRecoverySec": 0.60,
    "diveRecoveryFieldCut": 0.025,
    // #719: the normal jump. A fresh eligible West press takes off at once: 2.0 ft of root rise over 0.60 s (apex at 0.30),
    // the same for every character, one profile per press; a press blocked by the read or a recovery is remembered 0.10 s;
    // airborne the stick works at a tenth of the ground rates and a neutral body coasts; a jumping catch throws after it lands.
    "jumpAirSec": 0.60,
    "jumpRiseFt": 2.0,
    "jumpBufferSec": 0.10,
    "jumpAirResponseMul": 0.10
  },
  "drops": {
    "heatball": 0.35,
    "phonySwing": 0.35,
    "frozen": 0.4
  },
  "wallPlant": {
    "insideFenceFt": 8,
    "minFraction": 0.45,
    "fallbackInsideFt": 10,
    "minFt": 8
  },
  "abilities": {
    "bigCatchBonusFt": 6,
    "tagReachBonusFt": 2,
    "superJumpCatchBonusFt": 3,
    "superJumpFlyRangeFt": 22,
    "diveGroundRangeFt": 16,
    // Sand Scoop (Sable, #1149): +8 ft of ground reach for a ball at or below 1 ft (a skipping or rolling ball, below the
    // six-inch-to-knee hop band's top), and a scoop that low never bobbles. Half Dive's reach, for the low ball only.
    "sandScoopFt": 8,
    "sandScoopMaxFt": 1.0,
    // Long Toss (Hollis, #1150): the comfortable range runs 80 ft further before a long throw loses pace — an Arm 7 holder
    // throws 250 ft at full speed where the ordinary Arm 7 arm starts losing at 170. Nothing shorter changes.
    "longTossRangeFt": 80,
    // #723: Laser is x1.25 and only on a throw home with a live runner on third or the third-home segment (a cutoff feed never
    // carries it); Snap Throw is a 0.22 s release after a clean received teammate throw at x1.0 flight against the ordinary 0.30.
    "laserMul": 1.25,
    "snapThrowMul": 1.0,
    "snapReleaseSec": 0.22,
    // #718 (F693-02-ball-dash-carrier): dart, pip and jester (characters/role-players.json) carry the ball at x1.20
    // of their pursuit speed, automatically; the rates stay the body's own, so the boosted body takes 0.24 s to its cap.
    "ballDashMul": 1.20
  },
  "throw": {
    // #722 (F693-03-release-clock, F693-03-travel-clock): 0.30 s release, 0.90 s of flight over 80 ft for the neutral arm.
    "releaseSec": 0.30,
    "baseFtPerSec": 88.89,
    "minFtPerSec": 32,
    "armBase": 0.85,
    "armPerField": 0.03,
    // #722 (F693-03-long-throw-numbers): R = 160 + 5 (Arm - 5); flight += 0.60 x ((d - R) / 80)^2 past it, divided by
    // chemistry and ability with the rest. An Arm 5 throw is 4.80 s from 280 ft and 10.20 s from 400; a relay through
    // SS on the compact centre line arrives first beyond 221 / 237 / 258 / 272 ft for an Arm 3 / 5 / 8 / 10 thrower.
    "comfortableRangeFt": 160,
    "rangePerArmFt": 5,
    "longThrowLossSec": 0.60,
    "longThrowScaleFt": 80,
    // §8.7: the infielders who may take a relay on the line, and the middle of the line they may take it on.
    "cutoffPositions": ["SS", "2B", "1B", "3B"],
    "cutoffLaneMin": 0.15,
    "cutoffLaneMax": 0.85,
    "lateralSigmaPerFieldDeficitFt": 0.35,
    "lobMaxSec": 1.5,
    // #722 (decision 6 of #730): never forced. The CPU relays when the relay arrives first by the rung's relayBiasSec in
    // rules/cpu.json, and for no other reason. On this clock a relay through SS on the centre line wins beyond 221 / 237 /
    // 258 / 272 ft for an Arm 3 / 5 / 8 / 10 thrower.
    "onTheFlyFt": 9999,
    "unassistedFt": 8,
    "handHeightFt": 3.2,
    "bagHeightFt": 1.2,
    // #723 (F693-03-relay-ownership): each human relay leg needs its own command; an early press is remembered for 0.25 s of
    // active play and fires at the catch; bag selectors retarget it; a fresh RB / period cancels it.
    "relayBufferSec": 0.25
  },
  // How fast the loose ball slows is the ground's, not the throw's: grounds.json overthrow.decelFtPerSec2, read off the row of
  // the zone the ball is in (F3-c, FD-05).
  "overthrow": {
    "carryMul": 0.35,
    "maxRollFt": 45
  },
  "catcher": {
    "behindPlateFt": 3,
    "cpuReleaseBaseSec": 0.42,
    "cpuReleasePerField": 0.014,
    "cpuReleaseNoiseSec": 0.2,
    "cpuReleaseMinSec": 0.1,
    "cpuReleaseMaxSec": 0.58
  },
  "chem": {
    "goodSpeedMul": 1.30,
    // #722 (F693-03-negative-chemistry): a bad pair is slow, not random. 0.90 x the arm on every bad throw, no slant.
    "badSpeedMul": 0.90,
    "slantChance": 0,
    "slantSpeedMul": 0.70,
    "slantLateralMinFt": 10,
    "slantLateralMaxFt": 14
  },
  "bobble": {
    "handsPerGloveReduction": 3,
    "fumbleSec": 0.58
  },
  // #720 (F693-02-ground-pickup-recoil-basis, -cap, -recoil-field-shaping, -recoil-field-factors, -recoil-severity-curve,
  // -ordinary-recoil-actions, -ordinary-recoil-displacement, -ordinary-recoil-distance-cap, -ordinary-recoil-motion-profile):
  // a ground pickup costs the hands what the ball's actual incoming speed says, deterministic — S = clamp((v − 55) / (75 − 55)),
  // w = S × (1 − 0.05 × (Hands − 1)), the recovery 0.20 w s, a 10 w ft/s kick along the ball's travel slowing to rest over it
  // (w² ft), steering and the throw start waiting, possession and the contact at the bag kept. The knockback block above is
  // not read while onsetFtPerSec is above 0. The anchors are the measured ones (#720 slice 1, 48 cli matches on this profile,
  // 464 ground pickups): the onset 55 ft/s is the 90th percentile of every ground pickup's incoming speed — the hottest tenth
  // recoils, the rest is routine and costs nothing — and the full 75 ft/s is just past the hottest ball seen (73.0), so the cap
  // binds only on a true rocket. 11 % of CPU pickups recoil, none at the cap, 0.034 s among them; the old
  // knockback stopped 41 % of grounder pickups for 0.078 s on average. The airborne pair (slice 2, F693-02-grounded-air-catch-recoil)
  // is measured the same way on the same runs, 531 catches in the air: flies, pops and wall balls arrive at 22–42 ft/s with a
  // 0.59 vertical share and liners at p50 77 / p90 91 / max 110, so one pair cannot serve both — the ground pair would charge
  // 99 % of liners and cap a fifth of all catches. airOnsetFtPerSec 80 is the 90th percentile of every catch in the air (the
  // hottest tenth, 38 % of liners, no fly), airFullFtPerSec 115 just past the hottest catch seen (110.2). A dive, a jump or a
  // buddy leap is not a grounded catch and pays its own price instead.
  "recoil": {
    "onsetFtPerSec": 55,
    "fullFtPerSec": 75,
    "airOnsetFtPerSec": 80,
    "airFullFtPerSec": 115,
    "capSec": 0.20,
    "handsCutPerPoint": 0.05,
    "kickFtPerSec": 10
  },
  // #721 (F693-02-handling-error-opportunities, -ordinary-handling-error-chance, -ordinary-handling-error-cap,
  // -ordinary-handling-chance-curve, -awkward-hop-difficulty-source, -ordinary-bobble-outcome, -bobble-stun, -bobble-stun-duration,
  // -bobble-recovery-reliability, -bobble-direction-spread, -uniform-error-direction, -local-bobble-*): a legal routine pickup
  // never rolls. The one difficulty is the awkward in-between hop at the take — the ball rising off a real bounce, mid-way up a
  // hop tall enough to matter: D = (1 − |φ − 0.5| / 0.35) × (apex − 0.5) / (1.5 − 0.5), φ the ball's height over its
  // projected apex, both clamped to [0, 1]; the chance is 0.10 × D × (1 − 0.80 × H) with H the Hands (1 → 0, 10 → 1) — 10 / 6 / 2 %
  // at full difficulty for weak / middle / strong hands. The bands were measured on this profile (#721 slice 1, 48 cli matches, 483 ground pickups): a fifth of takes are rolls, half
  // are falling balls (the clean long hop), a quarter rising — and of those most are met near the top; 0.5 ft (six inches, the
  // bobble ceiling) is the micro-bounce line, 1.5 ft (the knee) full difficulty, 0.35 the phase half-width. 8.5 % of
  // CPU pickups carry any chance at all, 1.2 % on average among them: about one error a hundred CPU games. The seat's own
  // South-press take can meet any hop.A failed take is a local bobble: the ball spills down from the
  // contact with a fifth of its horizontal speed (six ft/s at most) inside ±30° of its travel, rebounds at 35 % under a six-inch
  // ceiling, settles below three inches, keeps 90 % of its roll per impact and slows at 6 ft/s²; the fumbler is stunned 0.40 s
  // while the ball and every other body stay live, and picking it up again never rolls. Or (slice 2) the ball gets past: the
  // obstruction is how squarely the ring met the ball (1 at the body, 0 at the edge of the take's window); below 0.5 on a ball
  // that came in at 55 ft/s or more (the recoil's hot line), the ball carries on with 0.80 → 0.50 of its horizontal and signed
  // vertical speed inside ±15° of its travel on the shared batted-ball ground physics — the contact and the speed decide, never
  // a second roll. The CPU takes at the edge of the ring, so its rare fumble on a hot ball is the ball getting past and on an
  // ordinary one the knockdown; the seat's own take at the body is always the knockdown. The bobble block above is not read.
  "handling": {
    "chanceCap": 0.10,
    "handsCut": 0.80,
    "hopMinApexFt": 0.5,
    "hopFullApexFt": 1.5,
    "hopPhaseHalfWidth": 0.35,
    "stunSec": 0.40,
    // The local bobble's restitution, the roll it keeps per impact and its rolling deceleration are the ground's: grounds.json
    // bobble, read off the row of the zone the ball is in (F3-c, FD-05). What stays here is the fumble's own.
    "bobbleSpreadDeg": 30,
    "bobbleRetain": 0.20,
    "bobbleCapFtPerSec": 6,
    "bobbleReboundCapFt": 0.50,
    "bobbleSettleFt": 0.25,
    "deflectSpreadDeg": 15,
    "deflectRetainMax": 0.80,
    "deflectRetainMin": 0.50,
    "deflectObstruction": 0.5,
    "deflectMinFtPerSec": 55
  },
  // #847 moved emberNightFireMul and pipeReachPadFt out of this block and under their hazard types
  // in rules/hazards.json. What is left is not a park hazard's: a shell or cask star swing flags a
  // grounder warped with no can in the park at all.
  "park": {
    "shellWarpChance": 0.6
  },
  // #625, spec §7.3: the batter squares at the West press and the defense reads it before the pitch. The corners
  // crash crashFt toward the plate at their own chase speed, coverFirst / coverSecond walk to their bags at the cover
  // speed, and after contact every charge body converges on the ball (the glove is still the earliest route, §8.2).
  // The throw follows §8.8 with the bunt's rows: the batter at first by default, the lead force only on a bunt at or
  // above hardExitMph, home on a squeeze only from inside squeezeHomeFt.
  "bunt": {
    "crashFt": 25,
    "crash": ["1B", "3B"],
    "coverFirst": "2B",
    "coverSecond": "SS",
    "charge": ["P", "C", "1B", "3B"],
    "chargeStopFt": 6,
    "squeezeHomeFt": 30,
    "hardExitMph": 36
  }
}

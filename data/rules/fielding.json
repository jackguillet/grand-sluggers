  // the full stick vector as the asked velocity, no calibration, no arming. trials/c80 carries 0.20 / 0.15: the calibrated
  // radial stick with hysteresis and the linear remap from leaveMag to 1. The calibration window is the accepted one in both.
  "stick": {
    "enterMag": 0,
    "leaveMag": 0,
    "calibrationSec": 0.50,
    "centerOffsetMax": 0.10,
    "sampleSpreadMax": 0.02
  },

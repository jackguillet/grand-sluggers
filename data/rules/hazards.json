// The closed hazard type library (spec §14, §16; FD-09, FR-02, FR-08). One authored row per type
// in data/parks/*.json: the pattern the sim runs for it, and the numbers that are the type's own.
// ParkHazards dispatches on the pattern, never on a type string, so a type that fits a pattern is a
// row here and nothing in the sim.
//
// fireBreath.nightRadiusMul was fielding.park.emberNightFireMul, and the two reachPadFt were
// fielding.park.pipeReachPadFt (#847, FR-06). #730 / #732 still own both. What a status volume costs a body is fielding.chase.frozenMul and the
// billboard's payout is stars.gains.billboard; neither moved, because a star swing sets the same slow.
//
// Whether an instance exists only at night is where the park authors it (its night block, FD-11,
// F4-d), not a column here: the rows carried nightOnly until then. nightRadiusMul stays, because it
// is a hazard type's own night number, which FD-11-R2 keeps.
// The one number added since is slowSec (F4-b, #896), below.
{
  // Crystal's freezers, Ember's lava and Ember's breath (FR-07, FD-08-R2; F4-b, #896): a body - a
  // fielder or a runner - that touches the disc runs at fielding.chase.frozenMul for slowSec from the
  // touch; staying inside keeps it slowed and entering again starts the time again. Nobody else is
  // slowed, and nothing is decided from where the ball lands. slowSec 3.0 is Jack's number
  // ("slows for 3 seconds", FD-08-R2, 2026-09-22), not yet played; only a
  // statusVolume carries it. Only the breath widens at night.
  "freezeVolume": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  "lavaPit": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  "fireBreath": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1.6,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  // Funfair's warp cans and Canopy's barrels (F4-c, FR-07, FD-08-R1): live. A ball that enters the disc
  // (radius + reachPadFt) at or below mouthFt comes out of another instance of the same type, drawn from
  // the match's seeded stream - the draw decides the exit, never a result - with exitSpeedMul of its
  // horizontal speed on the same heading and exitVyFtPerSec up. mouthFt, exitSpeedMul and
  // exitVyFtPerSec are proposed, not tuned (a trial for Jack's sitting). The pad is the larger part of the capture disc (#732), not a rounding
  // allowance, so it takes the fence scale with the radii: 8 x 0.70 = 5.60, and a Canopy
  // barrel's disc is 3.50 + 5.60 = 9.10 ft, 0.70 of the full-size 13.00.
  "warpPipe": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 5.6,
    "mouthFt": 3.5,
    "exitSpeedMul": 0.8,
    "exitVyFtPerSec": 12
  },
  "barrel": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 5.6,
    "mouthFt": 3.5,
    "exitSpeedMul": 1.1,
    "exitVyFtPerSec": 18
  },
  // Rooftop's star signs (F4-c): live. A ball whose live path passes inside the disc at or below topFt
  // (the sign's top) pays the batting team stars.gains.billboard, once a play, on a hit or a fly out.
  "billboard": {
    "pattern": "rewardTarget",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "topFt": 29
  },
  // Canopy's climb wall, a park rule (AB-12): any fielder whose wall leap is inside the park's disc climbs it and robs a ball
  // up to robFt over the fence, whatever ability they carry. 28 ft is a trial number (Clamber's old rob), not yet played.
  "climbWall": {
    "pattern": "wallTrait",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "robFt": 28
  },
  // Funfair's mouths (F4-c, FD-09-R2): a ball redirect, no longer a catch stealer. A ball that comes
  // into a mouth (between mouthFloorFt and mouthFt, so a fly on its way down, not a grounder) is spat out
  // of another one, live; nobody is out by a mouth. Night-only because Funfair authors them in its night block (F4-d).
  "chomper": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "mouthFt": 12,
    "mouthFloorFt": 4,
    "exitSpeedMul": 0.6,
    "exitVyFtPerSec": 16
  },
  // Solid bodies and the timed mover (F4-f): the ball below heightFt caroms off the body, keeping
  // restitution of its speed into it; a fielder cannot stand in one and the route goes around it. The
  // train runs travelFt to either side of its spot along the fence, once out and back per periodSec of
  // the play clock. Proposed numbers, not tuned.
  "statue": {
    "pattern": "solidBody",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "heightFt": 9,
    "restitution": 0.45
  },
  "train": {
    "pattern": "timedMover",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "heightFt": 10,
    "restitution": 0.45,
    "periodSec": 10,
    "travelFt": 50
  },
  "acUnit": {
    "pattern": "solidBody",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "heightFt": 5,
    "restitution": 0.55
  },
  "tree": {
    "pattern": "solidBody",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "heightFt": 20,
    "restitution": 0.35
  },
  // Stillwater Marsh's lily pads: a low timed mover. Only a ball under heightFt (a roller or a short hop) meets
  // one; each drifts travelFt either side of its spot, once out and back per periodSec. Proposed, not tuned.
  "lilyPad": {
    "pattern": "timedMover",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "heightFt": 1.5,
    "restitution": 0.4,
    "periodSec": 16,
    "travelFt": 18
  },
  // Coconut Cove's tide (#1153, WD-09 C): a surge band at each foul-side outfield corner. Every 12 s of the play clock (from a
  // seeded offset a play) the wave is in for 4 s, and a ball rolling at or below 0.5 ft inside the band drifts toward the
  // nearer foul line at 3 ft/s, 12 ft at most per band and never across the line. A ball in the air and every body are
  // untouched. High tide (night) reaches 1.4 times as far in.
  "tide": { "pattern": "surge", "nightRadiusMul": 1.4, "reachPadFt": 0, "heightFt": 0.5, "periodSec": 12, "surgeSec": 4, "carryFt": 12 },
  // Sunscorch Mesa's dust devils (#1154, WD-09 C): a disc that wanders up to 30 ft each way from its spot on a 14 s clock
  // (seeded phases a play). A ball in flight between 3 and 60 ft that passes inside it is pushed 10 ft sideways, away from
  // the devil's middle, spread over 0.4 s; once a play per devil. A grounder and every body are untouched.
  "dustDevil": { "pattern": "drift", "nightRadiusMul": 1, "reachPadFt": 0, "floorFt": 3, "topFt": 60, "periodSec": 14, "travelFt": 30, "pushFt": 10, "pushSec": 0.4 }
}

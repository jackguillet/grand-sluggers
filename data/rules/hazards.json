// The closed hazard type library (spec §14, §16; FD-09, FR-02, FR-08). One authored row per type
// in data/parks/*.json: the pattern the sim runs for it, and the numbers that are the type's own.
// ParkHazards dispatches on the pattern, never on a type string, so a type that fits a pattern is a
// row here and nothing in the sim.
//
// fireBreath.nightRadiusMul was fielding.park.emberNightFireMul, and the two reachPadFt were
// fielding.park.pipeReachPadFt (#847, FR-06). #730 / #732 still own both. What a status volume costs a body is fielding.chase.frozenMul and the
// billboard's payout is stars.gains.billboard; neither moved, because a star swing sets the same slow.
//
// Whether an instance exists only at night is where the park authors it (its night block, FD-11,
// F4-d), not a column here: the rows carried nightOnly until then. nightRadiusMul stays, because it
// is a hazard type's own night number, which FD-11-R2 keeps.
// The one number added since is slowSec (F4-b, #896), below.
{
  // Crystal's freezers, Ember's lava and Ember's breath (FR-07, FD-08-R2; F4-b, #896): a body - a
  // fielder or a runner - that touches the disc runs at fielding.chase.frozenMul for slowSec from the
  // touch; staying inside keeps it slowed and entering again starts the time again. Nobody else is
  // slowed, and nothing is decided from where the ball lands. slowSec 3.0 is Jack's number
  // ("slows for 3 seconds", FD-08-R2, 2026-09-22), not yet played; only a
  // statusVolume carries it. Only the breath widens at night.
  "freezeVolume": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  "lavaPit": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  "fireBreath": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1.6,
    "reachPadFt": 0,
    "slowSec": 3.0
  },
  // Funfair's warp cans and Canopy's barrels: a grounder landing inside radius + reachPadFt comes
  // out of another one. The pad is the larger part of the capture disc (#732), not a rounding
  // allowance, so it takes the fence scale with the radii: 8 x 0.70 = 5.60, and a Canopy
  // barrel's disc is 3.50 + 5.60 = 9.10 ft, 0.70 of the full-size 13.00.
  "warpPipe": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 5.6
  },
  "barrel": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 5.6
  },
  // Rooftop's star signs: a landing on one pays the batting team stars.gains.billboard.
  "billboard": {
    "pattern": "rewardTarget",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  // Canopy's climbable wall: a Clamber fielder's longer reach and taller rob. A park-wide flag
  // today; FD-06 makes it a property of a wall span.
  "climbWall": {
    "pattern": "wallTrait",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  // Funfair's mouths: a fly that lands in one is an out with no glove. Park data since #847 (three
  // C# literals behind a park-id test before it); night-only since F4-d because Funfair authors them
  // in its night block, which is also why this row no longer says so.
  "chomper": {
    "pattern": "catchStealer",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  // Drawn, never played (map §5 Q6, Jack, 2026-09-22). An honest row that says the type changes no
  // play, so a park may list one for the kit. Each gets a real pattern when its park comes up:
  // the solid body is F4-g's, the timed mover F4-f's.
  "statue": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  "train": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  "acUnit": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  "tree": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  }
}

// The closed hazard type library (spec §14, §16; FD-09, FR-02, FR-08). One authored row per type
// in data/parks/*.json: the pattern the sim runs for it, and the numbers that are the type's own.
// ParkHazards dispatches on the pattern, never on a type string, so a type that fits a pattern is a
// row here and nothing in the sim.
//
// Every number is the number that shipped (#847, FR-06): fireBreath.nightRadiusMul was
// fielding.park.emberNightFireMul, and the two reachPadFt were fielding.park.pipeReachPadFt.
// #730 / #732 still own both. What a status volume costs a body is fielding.chase.frozenMul and the
// billboard's payout is stars.gains.billboard; neither moved, because a star swing sets the same slow.
{
  // Crystal's freezers, Ember's lava and Ember's breath: a landing in the disc slows every chaser
  // for the whole play (fielding.chase.frozenMul). Only the breath widens at night.
  "freezeVolume": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  "lavaPit": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  "fireBreath": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1.6,
    "reachPadFt": 0,
    "nightOnly": false
  },
  // Funfair's warp cans and Canopy's barrels: a grounder landing inside radius + reachPadFt comes
  // out of another one. The pad is the larger part of the capture disc (#732), not a rounding
  // allowance, which is why trials/c80 scales it with the radii.
  "warpPipe": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 8,
    "nightOnly": false
  },
  "barrel": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 8,
    "nightOnly": false
  },
  // Rooftop's star signs: a landing on one pays the batting team stars.gains.billboard.
  "billboard": {
    "pattern": "rewardTarget",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  // Canopy's climbable wall: a Clamber fielder's longer reach and taller rob. A park-wide flag
  // today; FD-06 makes it a property of a wall span.
  "climbWall": {
    "pattern": "wallTrait",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  // Funfair's mouths: at night a fly that lands in one is an out with no glove. Park data since
  // #847; three C# literals behind a park-id test before it.
  "chomper": {
    "pattern": "catchStealer",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": true
  },
  // Drawn, never played (map §5 Q6, Jack, 2026-09-22). An honest row that says the type changes no
  // play, so a park may list one for the kit. Each gets a real pattern when its park comes up:
  // the solid body is F4-g's, the timed mover F4-f's.
  "statue": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  "train": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  "acUnit": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  },
  "tree": {
    "pattern": "decoration",
    "nightRadiusMul": 1,
    "reachPadFt": 0,
    "nightOnly": false
  }
}

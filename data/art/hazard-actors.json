    "fireBreath": "fire-statue",
    "warpPipe": "warp-can",
    "barrel": "barrel-cannon",
    "billboard": "star-billboard",
    "climbWall": "vine-climb",
    "chomper": "chomper-mouth",
    "statue": "keep-statue",
    "train": "midway-train",
    "acUnit": "ac-unit",
    "tree": "jungle-tree"
  },
  "rings": {
    "statusVolume": "#1A1A22",
    "ballRedirect": "#FFCC40",
    "rewardTarget": "#FFCC40"
  }
}

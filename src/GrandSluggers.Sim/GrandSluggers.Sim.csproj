<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GrandSluggers.Sim</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sim is deterministic: BannedSymbols.txt names the clock and unseeded-random APIs it must not call. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
</Project>

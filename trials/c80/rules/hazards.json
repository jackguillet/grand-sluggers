// #732, #730 decision 4, carried here by #847: the pad is the larger part of a barrel's capture
// disc (radius + reachPadFt), so it takes the fence scale with the radii in the park files.
// 8 x 0.70 = 5.60: a Canopy barrel's disc is 3.50 + 5.60 = 9.10 ft, exactly 0.70 of the shipped
// 13.00; scaling the radius alone would have left it at 11.50. The number lived in
// rules/fielding.json under park.pipeReachPadFt until the pattern library moved it here, and it did
// not change when it moved.
//
// fireBreath.nightRadiusMul is dimensionless and does not move. Apart from the two reachPadFt below,
// every value in this file is the shipped table, byte for byte.
{
  "freezeVolume": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  "lavaPit": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1,
    "reachPadFt": 0
  },
  "fireBreath": {
    "pattern": "statusVolume",
    "nightRadiusMul": 1.6,
    "reachPadFt": 0
  },
  "warpPipe": {
    "pattern": "ballRedirect",
    "nightRadiusMul": 1,
    "reachPadFt": 5.6
  },
  "barrel": {
